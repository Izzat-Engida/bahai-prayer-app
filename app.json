{
  "expo": {
    "name": "Bahai Prayer",
    "slug": "bahai-prayer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bahai.png",
    "scheme": "bahaiprayerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bahai.png",
      "bundleIdentifier": "com.izorium.bahaiprayerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A",
        "foregroundImage": "./assets/images/bahai.png",
        "backgroundImage": "./assets/images/bahai.png",
        "monochromeImage": "./assets/images/bahai.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "package": "com.izorium.bahaiprayerapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bahai.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2A4A",
          "image": "./assets/images/bahai.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e651670-a61f-46af-aea6-16a72e383610"
      }
    }
  }
}
