{
  "expo": {
    "name": "Bahai Prayer",
    "slug": "bahai-prayer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bahai.png",
    "scheme": "bahaiprayerapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/bahai.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A",
        "foregroundImage": "./assets/images/bahai.png",
        "backgroundImage": "./assets/images/bahai.png",
        "monochromeImage": "./assets/images/bahai.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bahai.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B2A4A",
          "image": "./assets/images/bahai.png",
          "imageWidth": 76
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-sqlite",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
